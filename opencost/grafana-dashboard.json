{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "OpenCost metrics source",
      "type": "datasource",
      "pluginId": "prometheus"
    }
  ],
  "title": "IDP Chargeback — Cost per Team",
  "uid": "idp-chargeback",
  "tags": ["opencost", "finops", "chargeback"],
  "timezone": "browser",
  "refresh": "1h",
  "time": { "from": "now-30d", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "team",
        "label": "Team",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(opencost_monthly_cost_estimate, label_team)",
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(opencost_monthly_cost_estimate, label_env)",
        "multi": true,
        "includeAll": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Monthly Spend by Team (USD)",
      "type": "bargauge",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sort_desc(sum by (label_team) (opencost_monthly_cost_estimate{label_team=~\"$team\"}))",
          "legendFormat": "{{ label_team }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 300 },
              { "color": "red", "value": 500 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Budget Utilization per Team (%)",
      "type": "gauge",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "100 * sum by (label_team) (opencost_monthly_cost_estimate{label_team=~\"$team\"}) / sum by (label_team) (opencost_budget_usd{label_team=~\"$team\"})",
          "legendFormat": "{{ label_team }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 150,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 80 },
              { "color": "red", "value": 100 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Daily Spend Trend by Team",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by (label_team) (increase(opencost_daily_cost_total{label_team=~\"$team\"}[1d]))",
          "legendFormat": "{{ label_team }}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "currencyUSD" }
      }
    },
    {
      "id": 4,
      "title": "Compute vs Storage vs Network Breakdown",
      "type": "piechart",
      "gridPos": { "x": 0, "y": 16, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum(opencost_cpu_cost_estimate{label_team=~\"$team\"})",
          "legendFormat": "CPU"
        },
        {
          "expr": "sum(opencost_memory_cost_estimate{label_team=~\"$team\"})",
          "legendFormat": "Memory"
        },
        {
          "expr": "sum(opencost_pv_cost_estimate{label_team=~\"$team\"})",
          "legendFormat": "Storage"
        },
        {
          "expr": "sum(opencost_network_cost_estimate{label_team=~\"$team\"})",
          "legendFormat": "Network"
        }
      ]
    },
    {
      "id": 5,
      "title": "Top 10 Most Expensive Pods",
      "type": "table",
      "gridPos": { "x": 8, "y": 16, "w": 16, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "topk(10, sum by (pod, namespace, label_team) (opencost_monthly_cost_estimate{label_team=~\"$team\"}))",
          "legendFormat": "",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "currencyUSD" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Value" }, "properties": [{ "id": "displayName", "value": "Monthly Cost (USD)" }] }
        ]
      }
    },
    {
      "id": 6,
      "title": "Idle / Unallocated Cost",
      "type": "stat",
      "gridPos": { "x": 0, "y": 24, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum(opencost_monthly_cost_estimate{label_team=\"\"})",
          "legendFormat": "Unattributed"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 100 }
            ]
          }
        }
      }
    }
  ]
}
